<Window x:Class="MuseLauncher.CredentialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="凭证导入 / 导出" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#121419" Foreground="#E9EBEE">
    <Window.Resources>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#0F1114"/>
            <Setter Property="Foreground" Value="#E9EBEE"/>
            <Setter Property="CaretBrush" Value="#E9EBEE"/>
            <Setter Property="BorderBrush" Value="#343943"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MaxLength" Value="1024"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="22">
        <TextBlock Text="把账号搬到另一台电脑" FontSize="18" FontWeight="Bold"/>
        <TextBlock Text="文件包含账号资料、代理密码和 Muse 登录 Cookie，请妥善保管。密码忘记后无法找回。"
                   TextWrapping="Wrap" Foreground="#AEB4BD" Margin="0,10,0,14"/>
        <StackPanel x:Name="ModePanel" Orientation="Horizontal" Margin="0,0,0,16">
            <RadioButton x:Name="ExportMode" Content="导出全部账号" IsChecked="True" Checked="OnModeChanged"/>
            <RadioButton x:Name="ImportMode" Content="从文件导入" Margin="24,0,0,0" Checked="OnModeChanged"/>
        </StackPanel>
        <TextBlock x:Name="PasswordLabel" Text="设置文件密码（至少 8 个字符）" Margin="0,0,0,6"/>
        <PasswordBox x:Name="PasswordInput"/>
        <StackPanel x:Name="ConfirmPanel" Margin="0,12,0,0">
            <TextBlock Text="再输入一次密码" Margin="0,0,0,6"/>
            <PasswordBox x:Name="ConfirmInput"/>
        </StackPanel>
        <TextBlock Text="导入会追加新账号，不覆盖本机账号。登录过期或恢复失败时需要重新登录；不包含网站缓存和其他浏览器数据。"
                   TextWrapping="Wrap" Foreground="#AEB4BD" Margin="0,16,0,0"/>
        <ProgressBar x:Name="Progress" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,16,0,0"/>
        <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,14,0,0" MaxHeight="220"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CloseButton" Content="关闭" IsCancel="True" Click="OnCloseClick"/>
            <Button x:Name="RunButton" Content="选择文件并导出" IsDefault="True" Click="OnRunClick"/>
        </StackPanel>
    </StackPanel>
</Window>
