<Window x:Class="MuseLauncher.AccountConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="账号配置" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#121419" WindowStyle="SingleBorderWindow">
    <Window.Resources>
        <Style x:Key="SmallBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#E9EBEE"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="#22252C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2E36"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E9EBEE"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="#E9EBEE"/>
            <Setter Property="CaretBrush" Value="#E9EBEE"/>
            <Setter Property="Background" Value="#0F1114"/>
            <Setter Property="BorderBrush" Value="#23262D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="18,16,18,16">
        <!-- 头像 -->
        <TextBlock Text="头像" Style="{StaticResource FieldLabel}"/>
        <DockPanel Margin="0,8,0,0">
            <Border DockPanel.Dock="Left" x:Name="TilePreview" Width="44" Height="44" CornerRadius="12"
                    Background="#151C28">
                <TextBlock x:Name="TileText" Text="m" FontFamily="Georgia" FontWeight="Bold" FontStyle="Italic"
                           FontSize="20" Foreground="#2F7CF6" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Margin="0,0,0,4"/>
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBox x:Name="AvatarInput" Style="{StaticResource FieldInput}" MaxLength="2"
                         TextChanged="OnAvatarChanged" Width="120" HorizontalAlignment="Left"/>
                <TextBlock Text="1-2 个字符或 Emoji" Foreground="#8A9099" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- 名称 -->
        <TextBlock Text="名称" Style="{StaticResource FieldLabel}" Margin="0,16,0,0"/>
        <TextBox x:Name="NameInput" Style="{StaticResource FieldInput}" MaxLength="16" Margin="0,8,0,0"/>

        <!-- 代理 -->
        <TextBlock Text="代理" Style="{StaticResource FieldLabel}" Margin="0,16,0,0"/>
        <TextBox x:Name="ProxyInput" Style="{StaticResource FieldInput}" Margin="0,8,0,0"/>
        <DockPanel Margin="0,8,0,0" LastChildFill="False">
            <Button x:Name="DetectBtn" Content="探测" Style="{StaticResource SmallBtn}" Click="OnDetectClick"/>
            <Button x:Name="TestBtn" Content="测活" Style="{StaticResource SmallBtn}" Margin="8,0,0,0" Click="OnTestClick"/>
            <TextBlock x:Name="TestStatus" DockPanel.Dock="Right" Foreground="#8A9099" FontSize="11.5"
                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="240" TextAlignment="Right"/>
        </DockPanel>
        <TextBlock Text="留空则跟随系统网络，支持 http / https / socks5。修改代理后重新进入该账号生效。"
                   Foreground="#8A9099" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>

        <!-- 标签 -->
        <TextBlock Text="标签" Style="{StaticResource FieldLabel}" Margin="0,16,0,0"/>
        <TextBox x:Name="TagsInput" Style="{StaticResource FieldInput}" Margin="0,8,0,0"/>
        <TextBlock Text="用逗号分隔，如：电商, 主力, 测试（用于侧栏搜索过滤，每个最多 8 个字符）"
                   Foreground="#8A9099" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>

        <!-- 操作 -->
        <DockPanel Margin="0,20,0,0" LastChildFill="False">
            <Button x:Name="CancelBtn" Content="取消" Style="{StaticResource SmallBtn}" Click="OnCancelClick"/>
            <Button x:Name="SaveBtn" Content="保存" Style="{StaticResource SmallBtn}" Margin="8,0,0,0"
                    Background="#3D7FFF" FontWeight="Bold" Click="OnSaveClick"/>
        </DockPanel>
    </StackPanel>
</Window>
