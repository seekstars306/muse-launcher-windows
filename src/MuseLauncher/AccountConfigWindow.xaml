<Window x:Class="MuseLauncher.AccountConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="账号配置" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#121419" WindowStyle="SingleBorderWindow">
    <Window.Resources>
        <Style x:Key="SmallBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#E9EBEE"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="#22252C"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E9EBEE"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="#E9EBEE"/>
            <Setter Property="CaretBrush" Value="#E9EBEE"/>
            <Setter Property="Background" Value="#0F1114"/>
            <Setter Property="BorderBrush" Value="#23262D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <StackPanel x:Name="RootPanel" Margin="18,16,18,16">
        <!-- 头像 -->
        <TextBlock x:Name="LblAvatar" Text="头像" Style="{StaticResource FieldLabel}"/>
        <DockPanel Margin="0,8,0,0">
            <Border DockPanel.Dock="Left" x:Name="TilePreviewHost" Width="48" Height="48"/>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="AvatarInput" Style="{StaticResource FieldInput}"
                             TextChanged="OnAvatarChanged" Width="108" HorizontalAlignment="Left"/>
                    <Button x:Name="UploadAvatarBtn" Content="上传图片" Style="{StaticResource SmallBtn}"
                            Margin="8,0,0,0" Click="OnUploadAvatarClick"/>
                    <Button x:Name="ClearAvatarBtn" Content="清除图片" Style="{StaticResource SmallBtn}"
                            Margin="6,0,0,0" Visibility="Collapsed" Click="OnClearAvatarClick"/>
                </StackPanel>
                <TextBlock x:Name="HintAvatar" Text="1-2 个字符/Emoji，或上传 PNG/JPG/WebP 图片（自动居中裁方）"
                           Foreground="#8A9099" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <!-- 名称 -->
        <TextBlock x:Name="LblName" Text="名称" Style="{StaticResource FieldLabel}" Margin="0,14,0,0"/>
        <TextBox x:Name="NameInput" Style="{StaticResource FieldInput}" MaxLength="16" Margin="0,8,0,0"/>

        <!-- 代理 -->
        <TextBlock x:Name="LblProxy" Text="代理" Style="{StaticResource FieldLabel}" Margin="0,14,0,0"/>
        <TextBox x:Name="ProxyInput" Style="{StaticResource FieldInput}" Margin="0,8,0,0"/>
        <DockPanel Margin="0,8,0,0" LastChildFill="False">
            <Button x:Name="DetectBtn" Content="探测" Style="{StaticResource SmallBtn}" Click="OnDetectClick"/>
            <Button x:Name="TestBtn" Content="测活" Style="{StaticResource SmallBtn}" Margin="8,0,0,0" Click="OnTestClick"/>
            <TextBlock x:Name="TestStatus" DockPanel.Dock="Right" Foreground="#8A9099" FontSize="11.5"
                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="270" TextAlignment="Right"/>
        </DockPanel>

        <!-- 绕过控制仅约束浏览器的代理规则，不是系统级防直连 -->
        <CheckBox x:Name="ForceProxyCheck" Content="取消浏览器本机地址的代理绕过（不是 VPN 防泄漏）"
                  Foreground="#C3C8D0" FontSize="11.5" Margin="0,10,0,0"/>

        <TextBlock x:Name="HintProxy1" Text="支持 HTTP / HTTPS / SOCKS5 上游认证，由每账号本机桥接处理。保存后重建环境，账号目录保留。"
                   Foreground="#8A9099" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="HintProxy2" Text="示例：http://用户名:密码@host:端口；特殊字符请百分号编码。HTTPS 上游验证证书；SOCKS5 由桥接完成真实认证。"
                   Foreground="#6F7680" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>

        <!-- 标签 -->
        <TextBlock x:Name="LblTags" Text="标签" Style="{StaticResource FieldLabel}" Margin="0,14,0,0"/>
        <TextBox x:Name="TagsInput" Style="{StaticResource FieldInput}" Margin="0,8,0,0"/>
        <TextBlock x:Name="HintTags" Text="用逗号分隔，如：电商, 主力, 测试（用于侧栏搜索过滤，每个最多 8 个字符）"
                   Foreground="#8A9099" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>

        <!-- 操作 -->
        <DockPanel Margin="0,18,0,0" LastChildFill="False">
            <Button x:Name="ShortcutBtn" Content="创建桌面快捷方式" Style="{StaticResource SmallBtn}"
                    Click="OnCreateShortcutClick" ToolTip="在桌面生成该账号独立图标，双击直达并全屏"/>
            <Button x:Name="SaveBtn" DockPanel.Dock="Right" Content="保存" Style="{StaticResource SmallBtn}"
                    Margin="8,0,0,0" Background="#3D7FFF" Foreground="White" FontWeight="Bold" Click="OnSaveClick"/>
            <Button x:Name="CancelBtn" DockPanel.Dock="Right" Content="取消" Style="{StaticResource SmallBtn}"
                    Click="OnCancelClick"/>
        </DockPanel>
    </StackPanel>
</Window>
