<Window x:Class="MuseLauncher.UpdateDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#121419" WindowStyle="SingleBorderWindow">
    <StackPanel Margin="20,18,20,18">
        <TextBlock x:Name="TitleLabel" Text="发现新版本" FontSize="17" FontWeight="Bold" Foreground="#E9EBEE"/>
        <TextBlock x:Name="VersionLabel" FontSize="12.5" Foreground="#8A9099" Margin="0,4,0,0"/>

        <Border x:Name="NotesCard" Background="#0F1114" BorderBrush="#23262D" BorderThickness="1"
                CornerRadius="10" Margin="0,12,0,0" Padding="12">
            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="NotesText" FontSize="12.5" LineHeight="20" Foreground="#E9EBEE"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,12,0,0">
            <ProgressBar x:Name="DownloadProgress" Height="6" Minimum="0" Maximum="100"
                         Foreground="#3D7FFF" Background="#23262D" BorderThickness="0"/>
            <TextBlock x:Name="StatusText" FontSize="11.5" Foreground="#8A9099" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <DockPanel Margin="0,16,0,0" LastChildFill="False">
            <Button x:Name="BtnClose" Content="稍后" Padding="14,7" Click="OnCloseClick"
                    Background="#22252C" Foreground="#E9EBEE" BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="BtnDownload" DockPanel.Dock="Right" Content="下载安装包" Padding="16,7"
                    Background="#3D7FFF" Foreground="White" FontWeight="Bold" BorderThickness="0"
                    Cursor="Hand" Click="OnDownloadClick"/>
            <Button x:Name="BtnOpenWeb" DockPanel.Dock="Right" Content="打开发布页" Padding="14,7"
                    Margin="0,0,8,0" Background="#22252C" Foreground="#E9EBEE" BorderThickness="0"
                    Cursor="Hand" Click="OnOpenWebClick"/>
        </DockPanel>
    </StackPanel>
</Window>
